{
  "description": "watch-pr-skill: on session start, arm the review bus in repos that opt in via a .review-bus.md.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
